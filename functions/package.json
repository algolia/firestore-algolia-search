{
  "name": "firestore-algolia-search",
  "version": "1.3.0",
  "description": "Index Cloud Firestore collection to Algolia (2nd Gen Cloud Functions kit)",
  "scripts": {
    "build": "npm run clean && npm test && npm run compile",
    "clean": "rimraf lib",
    "compile": "tsc",
    "lint": "pretty-quick --staged && lint-staged",
    "test": "jest --coverage",
    "prepublishOnly": "npm run build",
    "prepack": "npm run clean && npm run compile"
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "algoliasearch": "^4.23.3",
    "node-fetch": "^2.7.0"
  },
  "peerDependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.24.1",
    "@types/jest": "^27.5.2",
    "@types/js-yaml": "^4.0.8",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^4.2.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.4.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "lint-staged": "^13.3.0",
    "mocked-env": "^1.3.5",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.3.1",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
