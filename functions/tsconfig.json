{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "sourceMap": false,
    "outDir": "lib"
  },
  "compileOnSave": true,
  "include": [
    "src",
  ],
  "exclude": [
    "node_modules"
  ]
}
